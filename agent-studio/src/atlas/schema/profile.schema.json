{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soundcraft:agent-studio:atlas:profile",
  "title": "Plugin Atlas profile",
  "description": "One plugin at one major version (DESIGN.md 6.1). Every knowledge-bearing field has a provenance entry; an `inferred` provenance must have confidence below 0.9.",
  "type": "object",
  "additionalProperties": false,
  "required": ["identity", "params"],
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "vendor", "format", "plugin_id", "version", "os", "profiled"],
      "properties": {
        "name": { "$ref": "#/$defs/shortText" },
        "vendor": { "$ref": "#/$defs/shortText" },
        "format": { "enum": ["builtin", "clap", "vst3", "au"] },
        "plugin_id": { "type": "string", "minLength": 1, "maxLength": 300 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "os": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 5,
          "items": { "enum": ["macos", "windows", "linux", "freebsd", "web"] }
        },
        "profiled": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "summary": { "$ref": "#/$defs/longText" },
    "signal_flow": { "$ref": "#/$defs/longText" },
    "modes": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "$ref": "#/$defs/shortText" },
          "description": { "$ref": "#/$defs/longText" }
        }
      }
    },
    "params": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/param" }
    },
    "ui_only": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature", "procedure"],
        "properties": {
          "feature": { "$ref": "#/$defs/shortText" },
          "procedure": {
            "description": "A tested synthetic-input procedure, or the literal \"manual only\".",
            "$ref": "#/$defs/longText"
          }
        }
      }
    },
    "presets": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "$ref": "#/$defs/shortText" },
          "load": { "$ref": "#/$defs/longText" }
        }
      }
    },
    "known_issues": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/longText" }
    },
    "provenance": {
      "description": "Provenance for the fields outside params, keyed by field name (or identity.<field>).",
      "type": "object",
      "propertyNames": {
        "pattern": "^(identity(\\.(name|vendor|format|plugin_id|version|os|profiled))?|summary|signal_flow|modes|ui_only|presets|known_issues)$"
      },
      "additionalProperties": { "$ref": "#/$defs/provenance" }
    }
  },
  "$defs": {
    "shortText": { "type": "string", "minLength": 1, "maxLength": 200 },
    "longText": { "type": "string", "maxLength": 4000 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "confidence"],
      "properties": {
        "source": {
          "description": "host: read from the plugin host API; manual: from the vendor manual or a human; source: the plugin's own source code (SoundCraft built-ins only); measured: derived from offline bounces; inferred: a guess.",
          "enum": ["host", "manual", "source", "measured", "inferred"]
        },
        "ref": { "type": "string", "minLength": 1, "maxLength": 500 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "if": { "properties": { "source": { "const": "inferred" } }, "required": ["source"] },
      "then": { "properties": { "confidence": { "exclusiveMaximum": 0.9 } } }
    },
    "param": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "host_name"],
      "properties": {
        "id": { "type": ["string", "integer"], "minLength": 1, "maxLength": 200 },
        "host_name": { "type": "string", "maxLength": 200 },
        "name": { "$ref": "#/$defs/shortText" },
        "section": { "$ref": "#/$defs/shortText" },
        "role": { "$ref": "#/$defs/shortText" },
        "unit": { "type": "string", "maxLength": 32 },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "default": { "type": "number" },
        "taper": { "type": "string", "minLength": 1, "maxLength": 32 },
        "choices": { "type": "array", "maxItems": 1024, "items": { "type": "string", "maxLength": 200 } },
        "calibration": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "text"],
            "properties": {
              "value": { "type": "number" },
              "text": { "type": "string", "maxLength": 200 }
            }
          }
        },
        "does": { "$ref": "#/$defs/longText" },
        "musical_use": { "$ref": "#/$defs/longText" },
        "interactions": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/longText" } },
        "safe_range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number" }
        },
        "automatable": { "type": "boolean" },
        "provenance": {
          "description": "Field name -> provenance for the fields of this entry.",
          "type": "object",
          "propertyNames": {
            "enum": ["host_name", "name", "section", "role", "unit", "min", "max", "default", "taper", "choices", "calibration", "does", "musical_use", "interactions", "safe_range", "automatable"]
          },
          "additionalProperties": { "$ref": "#/$defs/provenance" }
        }
      }
    }
  }
}
