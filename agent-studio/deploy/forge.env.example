# Copy to forge.env and fill in. Never commit forge.env.
# Bearer token for the Forge API (python3 -c 'import secrets;print(secrets.token_urlsafe(32))').
FORGE_TOKEN=
# Tailscale address of the Spark (`tailscale ip -4`). The port is published only here.
FORGE_BIND_IP=
